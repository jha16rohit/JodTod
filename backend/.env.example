# ============================================================
# JodTod Backend Environment
# NEVER commit a real .env file or production secrets.
# ============================================================

APP_NAME=JodTod API
ENVIRONMENT=development
DEBUG=false
API_VERSION=v1
HOST=0.0.0.0
PORT=5000

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
# NOTE: JodTod secrets use CasedStr, so values DO NOT need quotes.
# The real value for local development lives ONLY in the untracked .env
# (see .gitignore) and MUST differ from this placeholder.
JWT_SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

OTP_EXPIRE_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30

PASSWORD_HASH_ALGORITHM=argon2id
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# PostgreSQL + asyncpg
SUPABASE_URL=...
SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...
DATABASE_URL=postgresql+asyncpg://USERNAME:PASSWORD@HOST:5432/jodtod
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_PRE_PING=true
DATABASE_ECHO=false

# Comma-separated values can be parsed by your deployment layer;
# alternatively configure this field through your environment manager.
CORS_ALLOWED_ORIGINS=["http://localhost:8081"]
CORS_ALLOW_CREDENTIALS=true

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=

# OTP / email providers
OTP_PROVIDER=
OTP_PROVIDER_API_KEY=
EMAIL_PROVIDER=smtp
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=JodTod
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TEST_RECIPIENT=

MAX_REQUEST_BODY_MB=10
TRUSTED_PROXY_COUNT=0

LOG_LEVEL=INFO
LOG_JSON=false
